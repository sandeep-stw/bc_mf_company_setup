# Copy to .env and fill in real values. Do not commit .env.
# Entra setup: config/entra-app-checklist.md (or scripts/Register-BCEntraApp.ps1)
# Token: . ./scripts/Get-BCAccessToken.ps1 ; Get-BCAccessToken

# Microsoft Entra tenant ID (GUID)
BC_TENANT_ID=00000000-0000-0000-0000-000000000000

# Business Central environment name (for example sandbox)
BC_ENVIRONMENT_NAME=sandbox

# Microsoft Entra app registration (client) ID
BC_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Microsoft Entra app client secret (required for OAuth; never commit a real value)
BC_CLIENT_SECRET=

# Business Central company ID (GUID from the companies API)
BC_COMPANY_ID=00000000-0000-0000-0000-000000000000

# Business Central API base URL without a trailing slash
# https://api.businesscentral.dynamics.com/v2.0/{tenantId}/{environmentName}
BC_API_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/00000000-0000-0000-0000-000000000000/sandbox
